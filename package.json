{
  "name": "foodspot",
  "version": "2.5.0",
  "description": "Food Spot — restaurant tracker for Obsidian with markdown-note storage",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node scripts/check-version.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node tests/smoke.test.mjs",
    "bump": "node scripts/bump-version.mjs",
    "install-local": "node scripts/install-local.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "fuse.js": "^7.0.0",
    "leaflet": "^1.9.4"
  }
}
